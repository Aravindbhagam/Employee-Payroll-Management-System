DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payrollpro_dev"
JWT_ACCESS_SECRET="change-this-access-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBER=30
PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash).
# For a GitHub Pages deploy, add https://<your-username>.github.io
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Optional: sending real password-reset emails via Resend (https://resend.com).
# Leave unset to keep the dev/test fallback (the email is logged server-side
# and, outside production, echoed in the API response instead of sent).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PayrollPro <onboarding@resend.dev>"

# Optional: pino log level (trace|debug|info|warn|error|fatal). Defaults to "info".
# LOG_LEVEL=info
